rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Kullanıcı Profilleri =====
    // Read: tüm giriş yapanlar (kullanıcı arama için)
    // Write: sadece kendisi
    // online/publicKey güncellemelerine izin ver
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'username', 'avatar', 'bio', 'publicKey', 'online', 'lastSeen', 'status']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ===== Arkadaşlık İstekleri =====
    match /friendRequests/{reqId} {
      allow read: if request.auth != null
        && (resource.data.from == request.auth.uid
          || resource.data.to == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.from == request.auth.uid
          || resource.data.to == request.auth.uid);
      allow delete: if request.auth != null
        && (resource.data.from == request.auth.uid
          || resource.data.to == request.auth.uid);
    }

    // ===== Arkadaş Listesi =====
    // Kendi listeni oku/yaz; ayrıca bir kullanıcı seni arkadaş olarak ekleyebilir (accept akışında)
    match /friends/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /list/{friendId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendId);
      }
    }

    // ===== Durumlar (Story / 24h) =====
    // Okuma: kendi durumun + arkadaşlarının durumu
    // Yazma: sadece kendi durumunu oluşturabilir
    // Güncelleme: sadece viewers alanı (görüntüleme kaydı)
    // Silme: sadece kendi durumunu
    match /stories/{storyId} {
      allow read: if request.auth != null && (
        resource.data.authorId == request.auth.uid
        || exists(/databases/$(database)/documents/friends/$(request.auth.uid)/list/$(resource.data.authorId))
      );
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'type', 'createdAt', 'expiresAt']);
      allow update: if request.auth != null
        && resource.data.authorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['viewers']);
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }

    // ===== Sohbetler =====
    // Sadece memberIds'deki kullanıcılar okuyabilir/yazabilir
    match /conversations/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      // ===== Call Signaling =====
      // Üyeler signalling verilerini okuyup yazabilir
      match /call_signals/{sigId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.memberIds;
        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.memberIds;
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.memberIds;
      }

      // ===== Mesajlar =====
      // Üst sohbetin memberIds'ine göre kontrol
      match /messages/{msgId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.memberIds;
        allow update, delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.memberIds;
      }
    }
  }
}
